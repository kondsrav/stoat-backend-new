stoat-dev.zasperhub.com {
    @notCanonical not host stoat-dev.zasperhub.com
    redir @notCanonical https://stoat-dev.zasperhub.com{uri} permanent

    handle_path /api/* {
        reverse_proxy stoat-backend-new-api-1:14702
    }

    handle_path /events* {
        reverse_proxy stoat-backend-new-events-1:14703
    }

    handle_path /ws* {
        reverse_proxy stoat-backend-new-events-1:14703
    }

    handle_path /autumn/* {
        reverse_proxy stoat-backend-new-autumn-1:14704
    }

    handle_path /january/* {
        reverse_proxy stoat-backend-new-january-1:14705
    }

    handle {
    reverse_proxy frontend-stoat-new-frontend-1:80
}
}

